# LearnHouse Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API Configuration
NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost:1338/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost:1338/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost:3000
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost:3000
NEXT_PUBLIC_LEARNHOUSE_HTTPS=false
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=false
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default

# NextAuth Configuration (REQUIRED)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# Internationalization (i18n)
# Supported languages: en, fr, es, de, bg
# Default language: en

# OAuth Providers (Optional)
# LEARNHOUSE_GOOGLE_CLIENT_ID=
# LEARNHOUSE_GOOGLE_CLIENT_SECRET=
